---
import Base from '../layouts/Base.astro';
import PluginCard from '../components/PluginCard.astro';
import Faceplate from '../components/Faceplate.astro';
import Icon from '../components/Icon.astro';
import { plugins, releasedPlugins } from '../data/plugins';
import { url } from '../lib/url';

const featured = releasedPlugins.slice(0, 3);
const hero = plugins.find((p) => p.isNew) ?? releasedPlugins[0];

const values = [
  { k: 'One screen', v: 'Every control visible. No tabs, no hidden menus.' },
  { k: 'Musical defaults', v: 'Presets made by working producers, not engineers.' },
  { k: 'Free, always', v: 'Every plugin is free to download. No account, no catch.' },
];
---

<Base>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="copy">
        <span class="eyebrow reveal">Audio plugins</span>
        <h1 class="reveal" style="--delay:.05s">
          Sound, in <span class="spectrum">every color.</span>
        </h1>
        <p class="lead reveal" style="--delay:.12s">
          Your sound. Our tools. Spectra makes focused, musical plugins for producers who would rather make music
          than menu-dive.
        </p>
        <div class="ctas reveal" style="--delay:.18s">
          <a href={url('plugins')} class="btn btn-primary">View plugins <Icon name="arrow" size={18} /></a>
          {hero && <a href={url(`plugins/${hero.slug}`)} class="btn">Meet {hero.name}</a>}
        </div>
      </div>

      {
        hero && (
          <a href={url(`plugins/${hero.slug}`)} class="hero-visual reveal" style="--delay:.2s">
            <Faceplate plugin={hero} size="hero" />
            <span class="floating badge badge-lime">New · {hero.name}</span>
          </a>
        )
      }
    </div>

    <div class="container">
      <ul class="values">
        {
          values.map((x, i) => (
            <li class="reveal" style={`--delay:${0.25 + i * 0.06}s`}>
              <strong>{x.k}</strong>
              <span>{x.v}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="plugins">
    <div class="container">
      <div class="head">
        <div>
          <span class="eyebrow reveal">The lineup</span>
          <h2 class="section-title reveal">Dive into our tools.</h2>
        </div>
        <a href={url('plugins')} class="btn btn-ghost reveal">All plugins <Icon name="arrow" size={18} /></a>
      </div>
      <div class="cards">
        {featured.map((p, i) => <PluginCard plugin={p} delay={i * 0.08} />)}
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="cta reveal">
        <h2>Like what you hear?</h2>
        <p class="lead">Browse every Spectra plugin, all free to download.</p>
        <a href={url('plugins')} class="btn btn-lime">View all plugins <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 112px);
    padding-bottom: 32px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 900px;
    background:
      radial-gradient(40% 45% at 72% 30%, rgb(114 59 250 / 0.35), transparent 70%),
      radial-gradient(25% 30% at 88% 55%, rgb(185 245 0 / 0.1), transparent 70%),
      radial-gradient(35% 40% at 15% 10%, rgb(114 59 250 / 0.14), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 50% 30%, #000, transparent);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }
  h1 {
    font-size: clamp(48px, 8.4vw, 104px);
    margin-top: 20px;
    letter-spacing: -0.035em;
  }
  .spectrum {
    background: linear-gradient(90deg, #9a72ff 0%, var(--violet) 45%, var(--lime) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: 24px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero-visual {
    position: relative;
    display: block;
    padding: 14px;
    border-radius: 24px;
    background: rgb(31 31 37 / 0.6);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    transform: perspective(1400px) rotateY(-8deg) rotateX(4deg);
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hero-visual.is-visible {
    transform: perspective(1400px) rotateY(-8deg) rotateX(4deg);
  }
  .hero-visual:hover {
    transform: perspective(1400px) rotateY(0) rotateX(0);
  }
  .floating {
    position: absolute;
    bottom: -12px;
    left: 28px;
    height: 30px;
    padding-inline: 14px;
    box-shadow: 0 10px 30px -8px rgb(185 245 0 / 0.5);
  }
  .values {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: clamp(64px, 9vw, 112px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
  }
  .values li {
    padding: 28px 28px 0 0;
    display: grid;
    align-content: start;
    gap: 6px;
  }
  .values li + li {
    padding-left: 28px;
    border-left: 1px solid var(--border);
  }
  .values strong {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }
  .values span {
    color: var(--text-muted);
    font-size: 15px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 48px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .cta-section {
    padding-top: 0;
  }
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: clamp(56px, 8vw, 96px) var(--gutter);
    border-radius: 28px;
    border: 1px solid var(--border);
    background:
      radial-gradient(60% 120% at 50% 120%, rgb(114 59 250 / 0.45), transparent 70%),
      var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .cta h2 {
    font-size: clamp(36px, 6vw, 64px);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual,
    .hero-visual.is-visible {
      transform: none;
    }
  }
  @media (max-width: 720px) {
    .values {
      grid-template-columns: 1fr;
    }
    .values li,
    .values li + li {
      padding: 20px 0;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .head {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
