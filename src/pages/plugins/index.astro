import Base from '../../layouts/Base.astro';
import PluginCard from '../../components/PluginCard.astro';
import { plugins } from '../../data/plugins';
import { site } from '../../data/site';
import { url } from '../../lib/url';
---

<Base title="Plugins" description={`Every ${site.name} audio plugin in one place.`}>
  <section class="page-head">
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow reveal">Catalog</span>
      <h1 class="reveal" style="--delay:.05s">Plugins</h1>
      <p class="lead reveal" style="--delay:.1s">
        Dive into our tools. Every plugin is free. Have a plugin idea?
        <a class="accent" href={url('contact')}>Get in touch</a>.
      </p>
    </div>
  </section>

  <section class="list">
    <div class="container">
      <div class="cards">
        {plugins.map((p, i) => <PluginCard plugin={p} delay={(i % 3) * 0.08} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    position: relative;
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: 56px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: -40% 0 auto;
    height: 600px;
    background: radial-gradient(40% 50% at 30% 40%, rgb(114 59 250 / 0.28), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .page-head .container {
    position: relative;
  }
  h1 {
    font-size: clamp(56px, 10vw, 120px);
    margin-top: 16px;
    letter-spacing: -0.04em;
  }
  .lead {
    margin-top: 20px;
  }
  .lead a:hover {
    text-decoration: underline;
  }
  .list {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
</style>
