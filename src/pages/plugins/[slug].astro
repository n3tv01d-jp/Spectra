---
import Base from '../../layouts/Base.astro';
import Faceplate from '../../components/Faceplate.astro';
import PluginCard from '../../components/PluginCard.astro';
import Icon from '../../components/Icon.astro';
import { formatPrice, releasedPlugins, type Plugin } from '../../data/plugins';
import { site } from '../../data/site';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return releasedPlugins.map((plugin) => ({ params: { slug: plugin.slug }, props: { plugin } }));
}

const { plugin } = Astro.props as { plugin: Plugin };
const free = plugin.price === 0;
const buyLabel = free ? 'Download free' : `Buy now · ${formatPrice(plugin)}`;
const buyHref = plugin.buyUrl ?? '#';
const others = releasedPlugins.filter((p) => p.slug !== plugin.slug).slice(0, 3);
---

<Base title={plugin.name} description={plugin.summary}>
  <section class="hero" style={`--h:${plugin.hue}`}>
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <nav class="crumbs reveal" aria-label="Breadcrumb">
        <a href={url('plugins')}>Plugins</a>
        <span>/</span>
        <span aria-current="page">{plugin.name}</span>
      </nav>

      <div class="intro">
        <p class="tagline reveal">{plugin.headline}</p>
        <h1 class="reveal" style="--delay:.05s">{plugin.name}</h1>
        <p class="category reveal" style="--delay:.1s">
          {plugin.category}
          {plugin.isNew && <span class="badge badge-lime">New</span>}
        </p>
        <div class="ctas reveal" style="--delay:.15s">
          <a href={buyHref} class:list={['btn', free ? 'btn-lime' : 'btn-primary']}>{buyLabel}</a>
          <a href="#features" class="btn btn-ghost">Explore features</a>
        </div>
        <ul class="formats reveal" style="--delay:.2s">
          {plugin.formats.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div class="visual reveal" style="--delay:.2s">
        <Faceplate plugin={plugin} size="hero" />
      </div>

      <p class="description lead reveal">{plugin.description}</p>
    </div>
  </section>

  <section class="section features" id="features">
    <div class="container">
      {
        plugin.features.map((f, i) => (
          <article class="feature reveal">
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  {
    plugin.highlights.length > 0 && (
      <section class="section highlights">
        <div class="container">
          <span class="eyebrow reveal">Under the hood</span>
          <h2 class="section-title reveal">Looking for more?</h2>
          <div class="grid">
            {plugin.highlights.map((h, i) => (
              <div class="cell reveal" style={`--delay:${(i % 3) * 0.06}s`}>
                <span class="tick">
                  <Icon name="check" size={16} />
                </span>
                <h3>{h.title}</h3>
                <p>{h.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section support">
    <div class="container">
      <div class="cta reveal" style={`--h:${plugin.hue}`}>
        <span class="eyebrow">Support independent DSP</span>
        <h2>Get {plugin.name}.</h2>
        <p class="lead">
          {free ? 'Free forever. No account, no catch.' : `One-time purchase of ${formatPrice(plugin)}. Free 1.x updates.`}
        </p>
        <a href={buyHref} class:list={['btn', free ? 'btn-lime' : 'btn-primary']}>{buyLabel}</a>
        <p class="small">Questions? <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section more">
        <div class="container">
          <h2 class="section-title reveal">More from {site.name}</h2>
          <div class="cards">
            {others.map((p, i) => (
              <PluginCard plugin={p} delay={i * 0.08} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    padding-top: 40px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: -10% 0 auto;
    height: 1000px;
    background:
      radial-gradient(40% 35% at 50% 45%, hsl(var(--h) 85% 55% / 0.28), transparent 70%),
      radial-gradient(30% 30% at 50% 20%, rgb(114 59 250 / 0.18), transparent 70%);
    filter: blur(24px);
    pointer-events: none;
  }
  .hero .container {
    position: relative;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--text-faint);
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs [aria-current] {
    color: var(--text-muted);
  }
  .intro {
    text-align: center;
    padding-top: clamp(40px, 7vw, 80px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .tagline {
    font-family: var(--font-display);
    color: var(--lime);
    font-size: 18px;
    font-weight: 500;
  }
  h1 {
    font-size: clamp(72px, 15vw, 180px);
    letter-spacing: -0.05em;
    margin-top: 8px;
    line-height: 0.9;
  }
  .category {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .formats {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .formats li {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 6px;
  }
  .visual {
    max-width: 920px;
    margin: clamp(48px, 7vw, 80px) auto 0;
    padding: 14px;
    border-radius: 26px;
    background: rgb(31 31 37 / 0.6);
    border: 1px solid var(--border);
  }
  .description {
    margin: clamp(48px, 7vw, 80px) auto 0;
    text-align: center;
    font-size: clamp(18px, 2.2vw, 24px);
    color: var(--text);
    max-width: 44ch;
    line-height: 1.5;
  }

  .features .container {
    display: grid;
    gap: 0;
  }
  .feature {
    display: grid;
    grid-template-columns: 80px 1.2fr 1fr;
    gap: 32px;
    align-items: baseline;
    padding-block: 44px;
    border-top: 1px solid var(--border);
  }
  .feature:last-child {
    border-bottom: 1px solid var(--border);
  }
  .index {
    font-family: var(--font-display);
    color: var(--violet-soft);
    font-size: 15px;
    letter-spacing: 0.1em;
  }
  .feature h2 {
    font-size: clamp(28px, 4vw, 44px);
  }
  .feature p {
    color: var(--text-muted);
    font-size: 17px;
  }

  .highlights {
    padding-top: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
  }
  .cell {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.3s;
  }
  .cell:hover {
    border-color: var(--border-strong);
  }
  .tick {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: rgb(185 245 0 / 0.12);
    color: var(--lime);
  }
  .cell h3 {
    font-size: 20px;
    margin-top: 20px;
  }
  .cell p {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 15px;
  }

  .support {
    padding-top: 0;
  }
  .cta {
    text-align: center;
    padding: clamp(56px, 8vw, 96px) var(--gutter);
    border-radius: 28px;
    border: 1px solid var(--border);
    background:
      radial-gradient(60% 120% at 50% 120%, hsl(var(--h) 85% 50% / 0.35), transparent 70%),
      var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .cta h2 {
    font-size: clamp(40px, 7vw, 76px);
  }
  .small {
    font-size: 14px;
    color: var(--text-faint);
  }
  .small a {
    color: var(--text-muted);
  }
  .small a:hover {
    color: var(--lime);
  }

  .more {
    padding-top: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .feature {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
